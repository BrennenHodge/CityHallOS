# Local development settings. Copy to .dev.vars (gitignored). These only work on your computer.
# ADMIN_KEY is the City Hall OS support code for localhost; the live and staging codes are different.
ADMIN_KEY=local-dev
# The administrator account dev_reset.py creates in every local city.
DEV_ADMIN_EMAIL=admin@cityhallos.test
DEV_ADMIN_PASSWORD=local-dev-password
# Optional: answer with Claude instead of Workers AI.
# ANTHROPIC_API_KEY=
# Lets you try the text and phone webhooks locally without Twilio's signature. Never set this in production.
TWILIO_ALLOW_UNSIGNED=1
