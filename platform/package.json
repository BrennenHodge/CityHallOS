{
  "name": "cityhallos-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "reset": "python -I scripts/dev_reset.py",
    "test": "python -I scripts/test_api.py http://127.0.0.1:8787 .dev.vars",
    "test:staging": "python -I scripts/test_api.py https://staging.cityhallos.com ../.secrets/staging-admin-key.txt",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "pdf-lib": "^1.17.1",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
