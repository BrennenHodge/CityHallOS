{
  // City Hall OS platform: staff dashboard, knowledge base API and the embeddable AI City Clerk.
  //   npx wrangler deploy
  // Secrets: ADMIN_KEY (City Hall OS operator access code), ANTHROPIC_API_KEY (optional; uses Claude instead of Workers AI).
// Optional, for messages to residents: RESEND_API_KEY + NOTIFY_FROM_EMAIL (email), TELNYX_API_KEY + TELNYX_PUBLIC_KEY + TELNYX_FROM (texts), TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM (calls, and texts without Telnyx).
// Optional, for Google address suggestions in applications: GOOGLE_MAPS_API_KEY (Places API (New)). Without it, suggestions come from Census street names.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cityhallos-platform",
  "account_id": "d06c70a0b6279642a6243926161f574b",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "cityhallos", "database_id": "d0f6c844-e64f-4e61-a8ff-95e60cf2251f" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "cityhallos-files" }],
  "ai": { "binding": "AI" },
  // One SQLite database per city (CityStore), plus the password service (AuthService). See ARCHITECTURE.md.
  "durable_objects": {
    "bindings": [
      { "name": "CITY_STORE", "class_name": "CityStore" },
      { "name": "AUTH", "class_name": "AuthService" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CityStore", "AuthService"] }],
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "routes": [{ "pattern": "app.cityhallos.com", "custom_domain": true }],
  // Daily at 15:00 UTC (9 or 10 am Central): permit reminders and business license renewal notices; and hourly reminders about unassigned requests.
  // Links in those messages use APP_ORIGIN.
  "triggers": { "crons": ["0 15 * * *", "30 * * * *"] },
  "vars": { "APP_ORIGIN": "https://app.cityhallos.com" },

  // Staging: the same code at staging.cityhallos.com with its own database, files and city stores.
  //   npx wrangler deploy --env staging
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging.cityhallos.com", "custom_domain": true }],
      // Card payments in test mode (src/payments.js): test cards only, nothing is charged. Never in production.
      "vars": { "APP_ORIGIN": "https://staging.cityhallos.com", "PAYMENTS_PROVIDER": "test" },
      "d1_databases": [
        { "binding": "DB", "database_name": "cityhallos-staging", "database_id": "a88f38be-ab9e-489b-9805-e4d3c532cb8b" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "cityhallos-files-staging" }],
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [
          { "name": "CITY_STORE", "class_name": "CityStore" },
          { "name": "AUTH", "class_name": "AuthService" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CityStore", "AuthService"] }],
      "ratelimits": [
        { "name": "CHAT_LIMIT", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        { "name": "LOGIN_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
